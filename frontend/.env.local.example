# Backend API (both can point to the same URL)
NEXT_PUBLIC_API_URL=http://localhost:8087
BACKEND_API_URL=http://localhost:8087

# Public site address, used for absolute share-preview image links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# reCAPTCHA v2 checkbox keys: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only: never expose this one in the browser
RECAPTCHA_SECRET_KEY=

# Tawk.to live chat — from Tawk dashboard → Administration → Chat Widget →
# Direct Chat Link: https://tawk.to/chat/<PROPERTY_ID>/<WIDGET_ID>
# Leave empty to turn the chat off. _AR is optional (a widget set to Arabic).
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID_AR=
